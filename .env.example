# Copy to .env and adjust. All settings use the LEDGERLET_ prefix.
LEDGERLET_ENVIRONMENT=development
LEDGERLET_DATABASE_URL=postgresql+psycopg://ledgerlet:ledgerlet@localhost:5432/ledgerlet
LEDGERLET_SQL_ECHO=false

# Where the web app runs. After connecting to HMRC the browser is sent back here.
# LEDGERLET_APP_BASE_URL=http://localhost:5173

# Sign-in. Production: your identity provider's issuer and JWKS URL.
# Local development: run `python scripts/dev_auth.py init` and paste what it prints.
# LEDGERLET_AUTH_ISSUER=
# LEDGERLET_AUTH_AUDIENCE=ledgerlet-api
# LEDGERLET_AUTH_JWKS_URL=
# LEDGERLET_AUTH_JWKS_FILE=

# HMRC sandbox (Developer Hub). Never commit real values.
# LEDGERLET_HMRC_CLIENT_ID=
# LEDGERLET_HMRC_CLIENT_SECRET=
# LEDGERLET_HMRC_TOKEN_KEY=   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Fraud prevention: our server's public IP (production), and whether we sit behind
# our own reverse proxy (only then is X-Forwarded-For trusted).
# LEDGERLET_HMRC_VENDOR_PUBLIC_IP=
# LEDGERLET_TRUST_PROXY_HEADERS=false

# Sandbox only: test scenario for the obligations call. Ignored in production.
# DYNAMIC is the one that works: the sandbox then generates obligations for its own
# example businesses (not ones you create), and LedgerLet picks the UK property group.
# LEDGERLET_HMRC_OBLIGATIONS_TEST_SCENARIO=DYNAMIC

# Used only by the test suite. Leave unset to run tests on in-memory SQLite.
# Must point at a database whose name contains "test": tests drop all tables.
# LEDGERLET_TEST_DATABASE_URL=postgresql+psycopg://ledgerlet:ledgerlet@localhost:5432/ledgerlet_test
