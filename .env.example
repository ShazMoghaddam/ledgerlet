# Copy to .env and adjust. All settings use the LEDGERLET_ prefix.
LEDGERLET_ENVIRONMENT=development
LEDGERLET_DATABASE_URL=postgresql+psycopg://ledgerlet:ledgerlet@localhost:5432/ledgerlet
LEDGERLET_SQL_ECHO=false

# Used only by the test suite. Leave unset to run tests on in-memory SQLite.
# Must point at a database whose name contains "test": tests drop all tables.
# LEDGERLET_TEST_DATABASE_URL=postgresql+psycopg://ledgerlet:ledgerlet@localhost:5432/ledgerlet_test
