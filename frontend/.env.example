# Copy to frontend/.env.local to sign in with Auth0 instead of a development token.
# All three are needed; leave them out to keep the development token box.
# These are public values (they end up in the built app), not secrets.
# VITE_AUTH0_DOMAIN=your-tenant.uk.auth0.com
# VITE_AUTH0_CLIENT_ID=
# VITE_AUTH0_AUDIENCE=https://api.ledgerlet.app
